<comic>
   <figures>
   </figures>
   <scenes>
      <scene>
         <!-- Panel 1: Experiment in progress -->
         <panel>
            <left>
               <figure>
                  <id>Alfie</id>
                  <name>Alfie</name>
                  <appearance>male</appearance>
                  <skin>light brown</skin>
                  <hair>dark brown</hair>
                  <lips>red</lips>
                  <pose>experimenting</pose>
                  <facing>right</facing>
               </figure>
               <balloon status="speech">
                  <content>This formula should turn water blue...</content>
               </balloon>
            </left>
            <right>
               <figure>
                  <appearance>default</appearance>
                  <skin>default</skin>
                  <hair>default</hair>
