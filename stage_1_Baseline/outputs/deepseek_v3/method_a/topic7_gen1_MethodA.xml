               </figure>
               <balloon status="speech">
                  <content>Oh no! It's affecting me too!</content>
               </balloon>
            </left>
            <right>
               <figure>
                  <id>Alfie</id>
                  <name>Alfie</name>
                  <appearance>male</appearance>
                  <skin>green</skin>
                  <hair>green</hair>
                  <lips>red</lips>
                  <pose>charmed</pose>
                  <facing>left</facing>
               </figure>
            </right>
