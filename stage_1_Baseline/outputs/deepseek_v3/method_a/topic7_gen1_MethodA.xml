         <!-- Panel 5: Surprising outcome -->
         <panel>
            <middle>
               <figure>
                  <id>Gemma</id>
                  <name>Gemma</name>
                  <appearance>female</appearance>
                  <skin>olive</skin>
                  <hair>black</hair>
                  <lips>pink</lips>
                  <pose>laughing</pose>
                  <facing>right</facing>
