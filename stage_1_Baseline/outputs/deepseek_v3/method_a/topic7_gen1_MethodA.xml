               </figure>
               <balloon status="speech">
                  <content>I don't feel so good...</content>
               </balloon>
            </left>
            <right>
               <figure>
                  <id>Gemma</id>
                  <name>Gemma</name>
                  <appearance>female</appearance>
                  <skin>olive</skin>
                  <hair>black</hair>
