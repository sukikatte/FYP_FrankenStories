            <setting>chemical plant</setting>
         </panel>

         <!-- Panel 4: Full transformation -->
         <panel>
            <left>
               <figure>
                  <id>Betty</id>
                  <name>Betty</name>
                  <appearance>female</appearance>
                  <skin>green</skin>
                  <hair>dark green</hair>
                  <lips>pink</lips>
