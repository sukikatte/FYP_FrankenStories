<?xml version="1.0" encoding="UTF-8"?>
<comic>
   <figures>
      <!-- Define global figure element here, or keep empty -->
   </figures>

   <scenes>
      <scene>
         <!--
            ComicXML STRUCTURE GUIDE
            
            PANEL STRUCTURE:
            Each panel can be divided into 1, 2, or 3 parts using position elements:
            
            Single part (choose one):
              - left element
              - middle element
              - right element
            
            Two parts (choose one combination):
              - left + right (most common)
              - left + middle
              - middle + right
            
            Three parts:
              - left + middle + right
            
            ELEMENTS IN EACH PANEL:
            Required:
              - At least one position element (left/middle/right)
              - setting element (placed directly in panel, after below if present)
            
            Optional:
              - below element (panel description text, placed after position elements)
              - balloon element (inside position elements where figure speaks)
              
            NOT used in content panels:
              - border element (only used in cover pages)
              - embedding element (only used in cover pages with special structure)
            
            Content panels setting placement:
              - Setting is placed directly in panel (after below element)
              - Do NOT use embedding structure
            
            FIGURE ELEMENTS:
            Character figure (required attributes):
              - id element (Alfie, Betty, or Gemma)
              - name element
              - appearance element
              - pose element
              - facing element (left or right)
            
            Character figure (optional, based on variant):
              - skin element
              - hair element
              - lips element
            
            IMPORTANT: You MUST select a complete character variant from element_library.json.
            Do NOT mix and match attributes - each variant has a complete set of attributes.
            
            Prop figure (for objects/props):
              - NO id or name elements
              - appearance element with value "default"
              - skin element with value "default"
              - hair element with value "default"
              - pose element (e.g., "horse prop", "wheelchair prop")
              - facing element (left or right)
            
            BALLOON:
            - Placed inside position element (left/middle/right) where the speaking figure is
            - Can have balloon in multiple positions (if multiple figures speak)
            - Can have no balloon at all
            - Format: balloon element with status="speech" and content element inside
         -->

         <!-- Example 1: Single part panel (middle) -->
         <panel>
            <middle>
               <figure>
                  <id>Betty</id>
                  <name>Betty</name>
                  <appearance>default=" Betty default appearance"</appearance>
                     <lips red default=" Betty lips red"/>
                  </appearance>
                  <facing right/>
               </figure>

               <balloon status="speech">
                  <content>Betty: "This lab is awesome!"</content>
               </balloon>
            </middle>

            <below> Betty is standing in a laboratory with a white lab coat on her head. The lab has a high ceiling with scientific equipment scattered around.</below>

            <setting>Laboratory window</setting>
         </panel>

         <!-- Example 2: Two part panel (left + right) - most common pattern -->
         <panel>
            <left>
               <figure>
                  <id>Betty</id>
                  <name>Betty</name>
                  <appearance>default=" Betty default appearance"</appearance>
                     <lips red default=" Betty lips red"/>
                  </appearance>
                  <facing left/>
               </figure>
            </left>
            <right>
               <figure>
                  <appearance>default=" lab coat default appearance"</appearance>
                     <pose lab coat prop " Betty lab coat prop"/>
                  </appearance>
                  <facing right/>
               </figure>

               <balloon status="speech">
                  <content>Betty: "This lab is amazing!"</content>
               </balloon>
            </right>

            <below> Betty is standing in a laboratory with a white lab coat on her head. The lab has a high ceiling with scientific equipment scattered around.</below>

            <setting>Laboratory window</setting>
         </panel>

         <!-- Example 3: Three part panel (left + middle + right) -->
         <panel>
            <left>
               <figure>
                  <id>Betty</id>
                  <name>Betty</name>
                  <appearance>default=" Betty default appearance"</appearance>
                     <lips red default=" Betty lips red"/>
                  </appearance>
                  <facing left/>
               </figure>
            </left>
            <middle>
               <figure>
                  <appearance>default=" Betty default appearance"</appearance>
                     <lips red default=" Betty lips red"/>
                  </appearance>
                  <facing left/>
               </figure>

               <balloon status="speech">
                  <content>Betty: "This lab is amazing!"</content>
               </balloon>
            </middle>
            <right>
               <!-- Prop figure example (no id/name, uses default values) -->
               <figure>
                  <appearance>default=" lab coat default appearance"</appearance>
                     <pose lab coat prop " Betty lab coat prop"/>
                  </appearance>
                  <facing right/>
               </figure>
            </right>

            <below> Betty is standing in a laboratory with a white lab coat on her head. The lab has a high ceiling with scientific equipment scattered around.</below>

            <setting>Laboratory window</setting>
         </panel>

         <!-- 
            NOTES:
            - Panel count is flexible based on story length
            - Use any combination of the patterns shown above
            - All panels should be content panels (no cover page structure)
            - Setting is always placed directly in panel (NOT in embedding)
            - Do NOT use framing, border or embedding elements (they are only for cover pages)
         -->
      </scene>
   </scenes>
</comic>