<?xml version="1.0" encoding="UTF-8"?>
<comic>
   <figures>
      <!-- define global figure element here, or keep empty -->
   </figures>

   <scenes>
      <scene>
         <!--
            ComicXML STRUCTURE GUIDE
            
            PANEL STRUCTURE:
            Each panel can be divided into 1, 2, or 3 parts using position elements:
            
            Single part (choose one):
              - left element
              - middle element
              - right element
            
            Two parts (choose one combination):
              - left + right (most common)
              - left + middle
              - middle + right
            
            Three parts:
              - left + middle + right
            
            ELEMENTS IN EACH PANEL:
            Required:
              - At least one position element (left/middle/right)
              - setting element (placed directly in panel, after below element)
            
            Optional:
              - below element (panel description text, placed after position elements)
              - balloon element (inside position elements where figure speaks)
            
            NOT used in content panels:
              - border element (only used in cover pages)
              - embedding element (only used in cover pages with special structure)
            
            Content panels setting placement:
              - Setting is placed directly in panel (after below element)
              - Do NOT use embedding structure
            
            FIGURE ELEMENTS:
            Character figure (required attributes):
              - id element (Alfie, Betty, or Gemma)
              - name element
              - appearance element
              - pose element
              - facing element (left or right)
            
            Character figure (optional, based on variant):
              - skin element
              - hair element
              - lips element
            
            IMPORTANT: You MUST select a complete character variant from element_library.json.
            Do NOT mix and match attributes - each variant has a complete set of attributes.
            
            Prop figure (for objects/props):
              - NO id or name elements
              - appearance element with value "default"
              - skin element with value "default"
              - hair element with value "default"
              - pose element (e.g., "horse prop", "wheelchair prop")
              - facing element (left or right)
            
            BALLOON:
            - Placed inside position element (left/middle/right) where the speaking figure is
            - Can have balloon in multiple positions (if multiple figures speak)
            - Can have no balloon at all
            - Format: balloon element with status="speech" and content element inside
         -->

         <!-- Example 1: Single part panel (middle) -->
         <panel>
            <middle>
               <figure>
                  <id>Alfie</id>
                  <name>Alfie</name>
                  <appearance default="false"/>
                  <skin black="true"/>
                  <hair brown="true"/>
                  <lips red="true"/>
                  <pose standing="true"/>
                  <facing right="true"/>
               </figure>
               <balloon status="speech">
                  <content>Betty, things are getting intense today.</content>
               </balloon>
               <figure>
                  <id>Betty</id>
                  <name>Betty</name>
                  <appearance default="false"/>
                  <skin black="true"/>
                  <hair brown="true"/>
                  <lips red="true"/>
                  <pose standing="true"/>
                  <facing right="true"/>
               </figure>
               <balloon status="speech">
                  <content>Yeah, the printer just malfunctioned. We'll have to figure out a new way to print reports.</content>
               </balloon>
               <figure>
                  <id>Gemma</id>
                  <name>Gemma</name>
                  <appearance default="false"/>
                  <skin black="true"/>
                  <hair brown="true"/>
                  <lips red="true"/>
                  <pose standing="true"/>
                  <facing right="true"/>
               </figure>
               <balloon status="speech">
                  <content>Hopefully, we can find a temporary solution.</content>
               </balloon>
            </middle>

            <below>The office printer area. The team is trying to find a workaround for the malfunctioning machine.</below>

            <setting>office</setting>
         </panel>

         <!-- Example 2: Two part panel (left + right) - most common pattern -->
         <panel>
            <left>
               <figure>
                  <id>Alfie</id>
                  <name>Alfie</name>
                  <appearance default="false"/>
                  <skin black="true"/>
                  <hair brown="true"/>
                  <lips red="true"/>
                  <pose standing="true"/>
                  <facing left="true"/>
               </figure>
               <balloon status="speech">
                  <content>What's going on here?</content>
               </balloon>
            </left>
            <right>
               <figure>
                  <id>Betty</id>
                  <name>Betty</name>
                  <appearance default="false"/>
                  <skin black="true"/>
                  <hair brown="true"/>
                  <lips red="true"/>
                  <pose standing="true"/>
                  <facing right="true"/>
               </figure>
               <balloon status="speech">
                  <content>It looks like the printer is acting up. We need to address this immediately.</content>
               </balloon>
            </right>

            <below>The team discusses the situation in the office conference room.</below>

            <setting>office desk</setting>
         </panel>
      </scene>
   </scenes>
</comic>