<?xml version="1.0" encoding="UTF-8"?>
<comic>
   <figures>
      <!-- define global figure element here, or keep empty -->
   </figures>

   <scenes>
      <scene>
         <!--
            ComicXML STRUCTURE GUIDE
            Panel Structure:
            Each panel can be divided into 1, 2, or 3 parts using position elements:
            Single part (choose one):
               - left element
               - middle element
               - right element
            Two parts (choose one combination):
               - left + right (most common)
               - left + middle
               - middle + right
            Three parts:
               - left + middle + right
            Elements in each panel:
            Required:
               - At least one position element (left/middle/right)
               - setting element (placed directly in panel, after below element)
            Optional:
               - below element (panel description text, placed after position elements)
               - balloon element (inside position elements where figure speaks)
            NOT used in content panels:
               - border element (only used in cover pages)
               - embedding element (only used in cover pages with special structure)
            Content panels setting placement:
               - Setting is placed directly in panel (after below element)
               - Do NOT use embedding structure
            FIGURE ELEMENTS:
            Character figure (required attributes):
               - id element (Alfie, Betty, or Gemma)
               - name element
               - appearance element
               - pose element
               - facing element (left or right)
            Character figure (optional, based on variant):
               - skin element
               - hair element
               - lips element
            Prop figure (for objects/props):
               - NO id or name elements
               - appearance element with value "default"
               - skin element with value "default"
               - hair element with value "default"
               - pose element (e.g., "ladder prop")
               - facing element (left or right)
            BALLOON:
            - Placed inside position element (left/middle/right) where the speaking figure is
            - Can have balloon in multiple positions (if multiple figures speak)
            - Can have no balloon at all
            - Format: balloon element with status="speech" and content element inside
         -->

         <!-- Example 1: Single part panel (middle) -->
         <panel>
            <middle>
               <figure>
                  <id>Alfie</id>
                  <name>Aldo Alfie</name>
                  <appearance default="true"/>
                  <skin default="true"/>
                  <hair default="true"/>
                  <lips default="true"/>
                  <pose>climbing</pose>
                  <facing>right</facing>
               </figure>
            </middle>
            <below>While climbing the ladder, I just happened upon something unusual.</below>
            <setting>Construction site, shadowy overgrown forest</setting>
         </panel>

         <!-- Example 2: Three part panel (left + middle + right) -->
         <panel>
            <left>
               <figure>
                  <id>Alfie</id>
                  <name>Aldo Alfie</name>
                  <appearance default="true"/>
                  <skin default="true"/>
                  <hair default="true"/>
                  <lips default="true"/>
                  <pose>climbing</pose>
                  <facing>right</facing>
               </figure>
            </left>
            <middle>
               <figure>
                  <id>Betty</id>
                  <name>Construction Manager Betty</name>
                  <appearance default="true"/>
                  <skin default="true"/>
                  <hair default="true"/>
                  <lips default="true"/>
                  <pose>entering</pose>
                  <facing>left</facing>
               </figure>
            </middle>
            <right>
               <figure>
                  <id>Alfie</id>
                  <name>Aldo Alfie</name>
                  <appearance default="true"/>
                  <skin default="true"/>
                  <hair default="true"/>
                  <lips default="true"/>
                  <pose>finding</pose>
                  <facing>right</facing>
               </figure>
            </right>
            <below>I found something really interesting here.</below>
            <setting>Construction site, shadowy overgrown forest</setting>
         </panel>

         <!-- Example 3: Three part panel (left + middle + right) -->
         <panel>
            <left>
               <figure>
                  <id>Alfie</id>
                  <name>Aldo Alfie</name>
                  <appearance default="true"/>
                  <skin default="true"/>
                  <hair default="true"/>
                  <lips default="true"/>
                  <pose>climbing</pose>
                  <facing>right</facing>
               </figure>
            </left>
            <middle>
               <figure>
                  <id>Betty</id>
                  <name>Construction Manager Betty</name>
                  <appearance default="true"/>
                  <skin default="true"/>
                  <hair default="true"/>
                  <lips default="true"/>
                  <pose>looking</pose>
                  <facing>left</facing>
               </figure>
            </middle>
            <right>
               <figure>
                  <id>Alfie</id>
                  <name>Aldo Alfie</name>
                  <appearance default="true"/>
                  <skin default="true"/>
                  <hair default="true"/>
                  <lips default="true"/>
                  <pose>excited</pose>
                  <facing>right</facing>
               </figure>
            </right>
            <below>Excitement turning to nervousness as I approach the discovery.</below>
            <setting>Construction site, shadowy overgrown forest</setting>
         </panel>

         <!-- 
            NOTES:
            - Panel count is flexible based on story length
            - Use any combination of the patterns shown above
            - All panels should be content panels (no cover page structure)
            - Setting is always placed directly in panel (NOT in embedding)
            - Do NOT use framing, border or embedding elements (they are only for cover pages)
         -->
      </scene>
   </scenes>
</comic>